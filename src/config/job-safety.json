        "Absprachen mit Fachplanung, Bauleitung und Kundschaft führen"
      ],
      "requirements": [
        "Abgeschlossene Ausbildung im Sanitärbereich",
        "Erfahrung in der Leitung oder Koordination von Sanitärarbeiten",
        "Selbstständige, zuverlässige und lösungsorientierte Arbeitsweise"
      ]
    },
    "planning": {
      "responsibilities": [
        "Sanitärpläne, Schemas und technische Unterlagen erstellen",
        "Planungsdetails mit den beteiligten Fachbereichen koordinieren",
        "Projektunterlagen prüfen, nachführen und termingerecht bereitstellen"
      ],
      "requirements": [
        "Abgeschlossene Ausbildung in Sanitärplanung oder Gebäudetechnik",
        "Gutes Verständnis für Normen, Schemas und technische Dokumentation",
        "Strukturierte, sorgfältige und teamorientierte Arbeitsweise"
      ]
    },
    "service": {
      "responsibilities": [
        "Sanitäranlagen warten, prüfen und bei Störungen instand setzen",
        "Fehler vor Ort eingrenzen und nachhaltige Lösungen umsetzen",
        "Ausgeführte Arbeiten sauber dokumentieren und übergeben"
      ],
      "requirements": [
        "Abgeschlossene Ausbildung im Sanitärbereich",
        "Erfahrung in Service, Unterhalt oder Störungsbehebung",
        "Zuverlässiges Auftreten und selbstständige Arbeitsweise"
      ]
    },
    "pipe": {
      "responsibilities": [
        "Rohrleitungs- und Entwässerungssysteme fachgerecht montieren",
        "Leitungen prüfen, instand setzen und Arbeiten dokumentieren",
        "Pläne und Sicherheitsvorgaben auf der Baustelle umsetzen"
      ],
      "requirements": [
        "Ausbildung oder fundierte Erfahrung im Sanitär- oder Rohrleitungsbau",
        "Sicherer Umgang mit Plänen, Werkzeugen und Verbindungstechniken",
        "Sorgfältige, belastbare und teamorientierte Arbeitsweise"
      ]
    },
    "installation": {
      "responsibilities": [
        "Sanitärinstallationen fachgerecht montieren, prüfen und dokumentieren",
        "Pläne und technische Vorgaben sicher in die Praxis umsetzen",
